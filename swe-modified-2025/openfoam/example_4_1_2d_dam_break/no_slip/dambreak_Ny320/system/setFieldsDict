FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.water 0
    volScalarFieldValue tracer.water 0
    volScalarFieldValue tracer.air 0
);

regions
(
    boxToCell
    {
        box (-30 0 -1) (50 1.5 1);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
        );
    }
    boxToCell
    {
	box (50 0 -1) (120 1 1);
	fieldValues
	(
	    volScalarFieldValue alpha.water 1
	);
    }
    boxToCell
    {
        box (-30 0 -1) (50 1.5 1);
        fieldValues
        (
            volScalarFieldValue tracer.water 1
        );
    }
);


